# Optional frontend configuration.
# Leave empty to use the Vite dev proxy (/api -> http://localhost:8000).
# Set this when the API lives on another origin, e.g. https://api.example.com
VITE_API_BASE=

# ── Phone sign-in (Firebase Authentication) ───────────────────────
# Firebase console → Project settings → Your apps → Web app → SDK config.
# Also enable Authentication → Sign-in method → Phone, and set the same API key
# as TITAN_FIREBASE_API_KEY in the backend .env. Leave empty to hide nothing:
# the Phone tab then explains that it is not set up.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
