# ── Svarah.ai / Titan — environment configuration ──────────────────
#
# Copy this file to `.env` (same folder) and fill in the values:
#
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER put a real key in this file — it is tracked.
# Existing environment variables win over `.env`.

# ── Runtime ───────────────────────────────────────────────────────
# mock = offline, deterministic providers; every output is labelled as demo.
# live = real Agnes + Sarvam + Magic Hour calls. Live mode never falls back to a mock:
#        a missing key or a provider failure is reported as an error.
TITAN_MODE=mock

# ── Backend ───────────────────────────────────────────────────────
# Defaults: backend/titan.db and backend/assets_store. Uncomment to move them.
# TITAN_DATABASE_URL=sqlite:///./titan.db
# TITAN_ASSETS_DIR=./assets_store
TITAN_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Fact lock / sessions ──────────────────────────────────────────
# Required. Generate two independent values, e.g.
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
# Without TITAN_SEAL_SECRET facts cannot be locked (so nothing can be planned).
# Changing it later invalidates the seal on already-locked facts.
TITAN_SEAL_SECRET=REPLACE_WITH_RANDOM_SEAL_SECRET
TITAN_AUTH_SECRET=REPLACE_WITH_RANDOM_AUTH_SECRET
# A session is renewed every time the website opens, so this is how long an
# owner can stay away before having to sign in again (8760 = one year).
TITAN_AUTH_TOKEN_TTL_HOURS=8760
# Password-less demo sign-in; only honoured in mock mode.
TITAN_ALLOW_DEMO_LOGIN=true

# ── Phone sign-in (Firebase Authentication) ───────────────────────
# The website verifies a phone number with Firebase (SMS code) and sends the
# resulting Firebase ID token to POST /api/auth/phone; the backend checks it
# with Google and issues a normal session. Set this to the Firebase project's
# Web API key (the same value as VITE_FIREBASE_API_KEY in frontend/apps/web/.env).
# Empty = phone sign-in is reported as unavailable.
TITAN_FIREBASE_API_KEY=

# ── Agnes AI: fact extraction + validation, Campaign Director, image, video ──
# Docs: https://wiki.agnes-ai.com
TITAN_AGNES_API_BASE=https://apihub.agnes-ai.com/v1
TITAN_AGNES_API_KEY=YOUR_AGNES_API_KEY
TITAN_AGNES_TEXT_MODEL=agnes-3.0-flash
TITAN_AGNES_IMAGE_MODEL=agnes-image-2.5-flash
TITAN_AGNES_VIDEO_MODEL=agnes-video-2.5

# Brag Director: the creative subagent that art-directs the poster and the
# frame-rendered campaign video (colours, type, hook line). Text model only.
TITAN_BRAG_AGENT_MODEL=agnes-3.0-flash

# auto | mock | agnes | none   (auto: mock in mock mode, Agnes in live mode)
TITAN_EXTRACTION_PROVIDER=auto

# ── Sarvam AI: the only speech provider (STT + TTS) ───────────────
# Docs: https://docs.sarvam.ai
# STT: sarvam | auto | mock | none.  In mock mode `sarvam` returns a labelled
# mock transcript; in live mode it calls Sarvam and never another engine.
TITAN_STT_PROVIDER=sarvam
# Up to four keys. Each call starts with the key that last worked and moves
# to the next when one is rejected, out of credits or rate limited.
# Leave the extra ones blank if you only have one.
TITAN_SARVAM_API_KEY=YOUR_SARVAM_API_KEY
TITAN_SARVAM_API_KEY_2=
TITAN_SARVAM_API_KEY_3=
TITAN_SARVAM_API_KEY_4=
TITAN_SARVAM_API_BASE=https://api.sarvam.ai
TITAN_SARVAM_STT_MODEL=saaras:v4
# TTS / voice: sarvam | auto | mock | none.  TTS uses Sarvam's bulbul:v3.
TITAN_VOICE_PROVIDER=sarvam
TITAN_MAX_VOICE_SAMPLE_MB=50

# ── Magic Hour: AI video (text-to-video) ──────────────────────────
# Docs: https://docs.magichour.ai
# auto | agnes | magichour   (auto: Magic Hour when keys are set, else Agnes video)
TITAN_VIDEO_PROVIDER=auto
TITAN_MAGICHOUR_API_BASE=https://api.magichour.ai
# One key, or several separated by commas. Keys are tried in order: when one is
# rejected or out of credits the next is used.
TITAN_MAGICHOUR_API_KEYS=YOUR_MAGICHOUR_API_KEY
# `default` lets Magic Hour pick for the account tier. Optional resolution
# override (480p | 720p | 1080p) — leave unset to use the tier default.
TITAN_MAGICHOUR_MODEL=default
# TITAN_MAGICHOUR_RESOLUTION=720p

# ── Provider calls ────────────────────────────────────────────────
# Per-request timeout (seconds) and bounded retries for transient failures
# (rate limits, 5xx, network). Auth/quota/validation errors are never retried.
TITAN_PROVIDER_TIMEOUT=30
TITAN_PROVIDER_MAX_RETRIES=2
TITAN_PROVIDER_BACKOFF_BASE=0.5
TITAN_MAX_REQUEST_BYTES=33554432

# ── Generation budgets (per campaign) and feature flags ───────────
TITAN_ENABLE_AGNES_VIDEO=true
TITAN_MAX_POSTERS=3
TITAN_MAX_VIDEO_VARIANTS=2
TITAN_MAX_VOICE_VARIANTS=5
TITAN_MAX_COPY_VARIANTS=3
# Local FFmpeg poster-reel jobs (separate from AI video).
TITAN_MAX_VIDEO_JOBS_PER_CAMPAIGN=2
TITAN_ENABLE_DEMO_SABOTAGE=false

# ── Jobs ──────────────────────────────────────────────────────────
# local = job state lives in the database and is advanced by status polling.
TITAN_TASKS_MODE=local
TITAN_CLOUD_PROJECT=
TITAN_CLOUD_TASKS_LOCATION=
TITAN_CLOUD_TASKS_QUEUE=
TITAN_CLOUD_RUN_WORKER_URL=

# ── Publishing (optional; not needed for campaign generation) ─────
TITAN_WINDSOR_MCP_URL=https://mcp.windsor.ai/
TITAN_WINDSOR_AUTH_MODE=oauth
TITAN_WINDSOR_API_KEY=
TITAN_WINDSOR_CONNECTOR_CACHE_SECONDS=300

# Posting to the owner's own social accounts (Upload-Post, https://upload-post.com).
# Each Svarah account gets its own Upload-Post profile; the owner links their
# Instagram / Facebook Page / X on Upload-Post's hosted connect page.
TITAN_UPLOADPOST_API_BASE=https://api.upload-post.com
TITAN_UPLOADPOST_API_KEY=

# ── GitHub sign-in (OAuth App, no Firebase) ───────────────────────
# github.com → Settings → Developer settings → OAuth Apps. Callback URL: <website origin>/auth/github
# The client ID is also set on the website as VITE_GITHUB_CLIENT_ID.
TITAN_GITHUB_CLIENT_ID=
TITAN_GITHUB_CLIENT_SECRET=
